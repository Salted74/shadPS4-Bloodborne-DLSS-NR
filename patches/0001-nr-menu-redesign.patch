+static void RenderSpeedSection(Config* config, float menuResScale, const NrCommon& nr)
+{
+    ImGui::SeparatorText("Where it runs, and speed");
+    ImGui::PushItemWidth(220.0f * menuResScale);
+
+    const Placement placement = ReadPlacement(config, nr);
+    bool finishedPicture = placement.finishedPicture;
+    bool beforeSr = placement.beforeSr;
+
+    // One exclusive choice: before SR, after SR and the finished picture are three places, not two checkboxes.
+    static const char* placementNames[] = { "After upscaling", "Before upscaling", "Finished picture" };
+    int choice = finishedPicture ? 2 : (beforeSr ? 1 : 0);
+
+    ImGui::BeginDisabled(placement.deferredActive);
+
+    if (ImGui::Combo("Runs", &choice, placementNames, IM_ARRAYSIZE(placementNames)))
+    {
+        if (choice == 2)
+        {
+            if (!finishedPicture)
+                RetryNr();
+
+            finishedPicture = true;
+            config->DlssNrFinishedPicture = true;
+        }
+        else
+        {
+            if (finishedPicture)
+                RetryNr();
+
+            finishedPicture = false;
+            beforeSr = choice == 1;
+            config->DlssNrFinishedPicture = false;
+            config->DlssNrRunBeforeSr = beforeSr;
+        }
+    }
+
+    ImGui::EndDisabled();
+
+    HelpMarker("Where in the game's frame NR works.\n"
+               "After upscaling (default): on the full-resolution frame DLSS has finished. Most detail; costs the "
+               "most.\n"
+               "Before upscaling: on the smaller frame DLSS starts from; DLSS then upscales NR's result. Cheaper, but "
+               "DLSS blends NR's changes over several frames, which can soften them.\n"
+               "Finished picture: after the game's own effects (DirectX 12 games). Can help with green noise, but NR "
+               "also changes the HUD and menus.\n"
+               "With Ray Reconstruction, NR always runs after it.");
+
+    if (placement.deferredActive)
+    {
+        ImGui::TextDisabled("Decided by Generate before SR, apply after SR (Fine-tune > Speed).");
+    }
+    else if (choice == 1 && placement.rayReconstruction)
+    {
+        ImGui::TextColored(ImVec4(0.9f, 0.6f, 0.25f, 1.0f), "Ray Reconstruction is on, so NR runs after it anyway.");
+    }
+    else if (choice == 2)
+    {
+        if (nr.enabled)
+        {
+            const auto feature = State::Instance().currentFeature;
+
+            if (feature && (feature->Api() != API::DX12 || feature->IsWithDx12()))
+                ImGui::TextWrapped("This needs a native DirectX 12 game.");
+            else
+                ImGui::TextWrapped("%s", DlssNr::FinishedPictureStatus().c_str());
+        }
+
+        if (ImGui::Checkbox("Run the model before upscaling", &beforeSr))
+        {
+            config->DlssNrRunBeforeSr = beforeSr;
+            config->DlssNrDeferredDlss = false;
+        }
+
+        HelpMarker("Runs the model on the smaller frame, upscales its changes with DLSS and applies them to the "
+                   "finished picture. Experimental; colours may differ. Needs DLSS SR, not RR.");
+
+        if (beforeSr)
+            ImGui::TextWrapped("Changes from before upscaling: %s", DlssNr::DeferredDlssStatus().c_str());
+    }
+
+    // Model resolution: any percentage, committed when the handle is let go -- every distinct value is a different
+    // working size, and each one rebuilds the model.
+    const bool resolutionAuto = config->DlssNrModelResolutionAuto.value_or_default();
+    const bool autoApplies = !beforeSr || placement.rayReconstruction;
+    const bool autoActive = resolutionAuto && autoApplies;
+    int scalePercent = autoActive          ? DlssNr::CurrentModelResolutionPercent()
+                       : pendingScale >= 0 ? pendingScale
+                                           : (int) lroundf(config->DlssNrWorkingScale.value_or_default() * 100.0f);
+
+    ImGui::BeginDisabled(autoActive);
+
+    if (ImGui::SliderInt("Model resolution", &scalePercent, 25, 200, "%d%%"))
+        pendingScale = scalePercent;
+
+    // Before the Reset button becomes the last item: IsItemDeactivatedAfterEdit only reports on the last one.
+    const bool sliderReleased = ImGui::IsItemDeactivatedAfterEdit();
+
+    ImGui::SameLine();
+    if (ImGui::SmallButton("Reset##modelresolution"))
+    {
+        config->DlssNrWorkingScale = 1.0f;
+        pendingScale = -1;
+    }
+
+    ImGui::EndDisabled();
+
+    if (!autoActive && sliderReleased && pendingScale >= 0)
+    {
+        config->DlssNrWorkingScale = std::clamp(pendingScale, 25, 200) / 100.0f;
+        pendingScale = -1;
+    }
+
+    HelpMarker("How large a picture the model works on, compared with the frame it gets. 100%: full detail. Lower: "
+               "faster and softer. Above 100%: more detail at more cost. The game's own resolution does not change. "
+               "Applies when you let go of the slider.");
+
+    {
+        unsigned int modelWidth = 0;
+        unsigned int modelHeight = 0;
+
+        if (nr.vulkan)
+            DlssNr::CurrentModelSizeVk(modelWidth, modelHeight);
+        else
+            DlssNr::CurrentModelSize(modelWidth, modelHeight);
+
+        if (modelWidth != 0 && modelHeight != 0)
+            ImGui::TextDisabled("The model works on %ux%u.", modelWidth, modelHeight);
+    }
+
+    bool matchRender = resolutionAuto;
+
+    ImGui::BeginDisabled(!autoApplies);
+    if (ImGui::Checkbox("Match the game's render resolution", &matchRender))
+        config->DlssNrModelResolutionAuto = matchRender;
+    ImGui::EndDisabled();
+
+    HelpMarker("After upscaling only: the model works at the resolution the game renders at before DLSS, a fraction of "
+               "the cost of full resolution. Overrides Model resolution.");
+
+    if (resolutionAuto && !autoApplies)
+        ImGui::TextDisabled("No effect before upscaling: the model already works on the smaller frame there.");
+
+    {
+        const float width = TierButtonWidth();
+        ButtonFlow flow;
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextUnformatted("Presets:");
+        flow.Placed();
+
+        // The tiers keep where NR runs: only its size and how its result is enlarged back change.
+        ImGui::PushID("tiers");
+
+        for (const auto& tier : ResolutionTiers)
+        {
+            flow.Next(width);
+
+            if (PresetButton(tier.name, ResolutionTierActive(config, tier, beforeSr), width))
+                ApplyResolutionTier(config, pendingScale, tier, beforeSr);
+        }
+
+        ImGui::PopID();
+        HelpMarker("Model resolution, and how the result is enlarged back, in one click; where NR runs stays as it is. "
+                   "High: 100%. Medium: 80%. Low: 65%. Potato: 50%. Green = in effect.");
+    }
+
+    {
+        const unsigned int passLimit =
+            config->DlssNrUnlockPasses.value_or_default() ? MaxPassCount : DefaultMaxPassCount;
+        int passes = (int) std::clamp(config->DlssNrPasses.value_or_default(), 1u, passLimit);
+        const ImVec4 colour = passes <= 1   ? ImVec4(0.35f, 0.88f, 0.38f, 1.0f)
+                              : passes == 2 ? ImVec4(0.95f, 0.70f, 0.20f, 1.0f)
+                                            : ImVec4(0.92f, 0.30f, 0.25f, 1.0f);
+
+        ImGui::PushStyleColor(ImGuiCol_Text, colour);
+        ImGui::PushStyleColor(ImGuiCol_SliderGrab, colour);
+
+        if (ImGui::SliderInt("Passes", &passes, 1, (int) passLimit, passes == 1 ? "%d (normal)" : "%dx model cost"))
+            config->DlssNrPasses = (uint32_t) std::clamp(passes, 1, (int) passLimit);
+
+        ImGui::PopStyleColor(2);
+
+        ImGui::SameLine();
+        if (ImGui::SmallButton("Reset##modelpasses"))
+            config->DlssNrPasses = 1u;
+
+        HelpMarker(
+            "How many times the model runs on each frame. 1 is normal. 2 or 3: a stronger effect for 2x or 3x the "
+            "cost. Each pass can be tuned on Fine-tune.");
+    }
+
+    {
+        // Off in Vulkan games, natively and through the D3D12 bridge: the reused result can flash in dark scenes. The
+        // setting belongs to the kernel set running (NVIDIA's FP8 one, or the plain FP16 one some modified DLLs use).
+        const bool vulkanGame = DlssNr::IsRunningVk() || State::Instance().api == Vulkan;
+        auto& every = DlssNrNative::VitPlainKernels() ? config->DlssNrVitEveryPlain : config->DlssNrVitEvery;
+        bool reuse = !vulkanGame && every.value_or_default() > 1;
+
+        ImGui::BeginDisabled(vulkanGame);
+        if (ImGui::Checkbox("Reuse the model's coarse stage", &reuse))
+            every = reuse ? 2u : 1u;
+        ImGui::EndDisabled();
+
+        HelpMarker("Computes the model's coarsest stage every other frame and reuses it in between: about a tenth less "
+                   "NR time; fast motion can look slightly softer. Off in Vulkan games.");
+    }
+
+    ImGui::PopItemWidth();
+}
