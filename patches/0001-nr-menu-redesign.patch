+// Where NR is set to run, worked out once from the config and the game's upscaler. Every page asks this instead of
+// repeating the rules.
+struct Placement
+{
+    bool finishedPicture;
+    bool beforeSr;          // before SR (on the finished picture: the model runs before SR)
+    bool rayReconstruction; // the game runs Ray Reconstruction, so NR goes after it whatever is set
+    bool deferredActive;    // Generate before SR, apply after SR is on and decides the placement
+};
+
+static Placement ReadPlacement(const Config* config, const NrCommon& nr)
+{
+    const auto feature = State::Instance().currentFeature;
+    const bool rayReconstruction = feature && feature->GetUpscalerType() == Upscaler::DLSSD;
+    const bool deferred = config->DlssNrDeferredDlss.value_or_default();
+
+    return { nr.finishedPicture, config->DlssNrRunBeforeSr.value_or_default() || (nr.finishedPicture && deferred),
+             rayReconstruction, !nr.finishedPicture && deferred && !rayReconstruction };
+}
