+// Fine-tune > Exposure: what Brightness on the Main page leaves out -- the numbers behind it, how Automatic measures
+// and adapts, Scanned exposure's setup, and the highlight guard.
+static void RenderExposureDetails(Config* config, float menuResScale)
+{
+    ImGui::PushItemWidth(220.0f * menuResScale);
+
+    // Whether these controls act on the frame NR last ran on (shaders/dlssnr/DlssNr_ExposureState.h). They pick the
+    // white point that divides a linear HDR frame; a tone-mapped frame reaches the model as it is, and a display HDR
+    // frame (HDR10, scRGB, forced PQ) is put at its paper white instead. Shown greyed rather than hidden, so the values
+    // stay visible and come back as they were on a linear HDR frame. Highlight guard, below, acts in every case.
+    const auto encodingStatus = DlssNr::ReadColourEncodingStatus();
+    const auto exposureState =
+        encodingStatus.seen ? encodingStatus.exposureState : DlssNrExposureState::State::LinearHdr;
+    const bool exposureActs = exposureState == DlssNrExposureState::State::LinearHdr;
+
+    if (!exposureActs)
+        ImGui::TextColored(ImVec4(0.9f, 0.6f, 0.25f, 1.0f),
+                           "%s, so only the highlight guard below acts. How it was read: Colour and composition.",
+                           exposureState == DlssNrExposureState::State::ToneMapped
+                               ? "This game's picture is already tone mapped"
+                               : "This is an HDR10 or scRGB picture");
+
