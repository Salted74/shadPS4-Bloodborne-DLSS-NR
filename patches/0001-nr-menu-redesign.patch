+// The nvngx_dlssnr.dll the model runs from (or will load): its file version, and how many trained networks
+// ("weights") it carries. NVIDIA's DLLs keep each as a resource named WEIGHTS_*: 310.8 has one (WEIGHTS_HT), 310.9 two
+// (WEIGHTS_HT and WEIGHTS_CC_SMALL_FP8), and a backport can have two whatever its version says.
+struct NrRuntime
+{
+    version_t version;
+    int weightSets = 0; // 0: the resources could not be counted
+};
+
+static int CountWeightSets(HMODULE module)
+{
+    // Looked up when needed rather than linked, so this line of the menu adds no import to OptiScaler.dll.
+    using EnumTypes = decltype(&EnumResourceTypesW);
+    using EnumNames = decltype(&EnumResourceNamesW);
+
+    struct Search
+    {
+        EnumNames enumNames;
+        int count;
+    };
+
+    const HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+
+    if (kernel32 == nullptr)
+        return 0;
+
+    const auto enumTypes = reinterpret_cast<EnumTypes>(GetProcAddress(kernel32, "EnumResourceTypesW"));
+    Search search { reinterpret_cast<EnumNames>(GetProcAddress(kernel32, "EnumResourceNamesW")), 0 };
+
+    if (enumTypes == nullptr || search.enumNames == nullptr)
+        return 0;
+
+    enumTypes(
+        module,
+        [](HMODULE m, LPWSTR type, LONG_PTR param) -> BOOL
+        {
+            reinterpret_cast<Search*>(param)->enumNames(
+                m, type,
+                [](HMODULE, LPCWSTR, LPWSTR name, LONG_PTR param) -> BOOL
+                {
+                    if (!IS_INTRESOURCE(name) && std::wcsncmp(name, L"WEIGHTS_", 8) == 0)
+                        reinterpret_cast<Search*>(param)->count++;
+
+                    return TRUE;
+                },
+                param);
+
+            return TRUE;
+        },
+        reinterpret_cast<LONG_PTR>(&search));
+
+    return search.count;
+}
+
+// Read once the DLL is found, retried at most every two seconds until then. The module once it is loaded, else the two
+// folders NR loads it from -- never a recursive search, this runs while the menu is drawn.
+static std::optional<NrRuntime> NrRuntimeInfo()
+{
+    static std::optional<NrRuntime> found;
+    static double nextTryMs = 0.0;
+
+    if (found.has_value())
+        return found;
+
+    const double now = Util::MillisecondsNow();
+
+    if (now < nextTryMs)
+        return std::nullopt;
+
+    nextTryMs = now + 2000.0;
+    std::filesystem::path path;
+    const HMODULE loaded = GetModuleHandleW(L"nvngx_dlssnr.dll");
+
+    if (loaded != nullptr)
+    {
+        wchar_t buffer[MAX_PATH] {};
+
+        if (GetModuleFileNameW(loaded, buffer, MAX_PATH) != 0)
+            path = buffer;
+    }
+
+    for (const std::filesystem::path& folder : { Util::DllPath().parent_path(), Util::ExePath().parent_path() })
+    {
+        std::error_code ec;
+
+        if (path.empty() && std::filesystem::is_regular_file(folder / L"nvngx_dlssnr.dll", ec))
+            path = folder / L"nvngx_dlssnr.dll";
+    }
+
+    NrRuntime runtime;
+
+    if (path.empty() || !Util::GetFileVersion(path.wstring(), &runtime.version) || runtime.version.major == 0)
+        return std::nullopt;
+
+    // Mapped as data only when NR has not loaded it yet: nothing in it runs.
+    const HMODULE module = loaded != nullptr
+                               ? loaded
+                               : LoadLibraryExW(path.wstring().c_str(), nullptr,
+                                                LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE);
+
+    if (module != nullptr)
+    {
+        runtime.weightSets = CountWeightSets(module);
+
+        if (loaded == nullptr)
+            FreeLibrary(module);
+    }
+
+    found = runtime;
+    return found;
+}
